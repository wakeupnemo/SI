<Project>
	<PropertyGroup>
		<Authors>Vladimir Khil</Authors>
		<Company>Khil-soft</Company>
		<Copyright>Copyright © Khil-soft 2002 - 2026</Copyright>
		<SIGameVersion>7.13.12</SIGameVersion>
		<SIQuesterVersion>6.9.1</SIQuesterVersion>
		<SIQuesterCrossPlatformVersion>0.3.0</SIQuesterCrossPlatformVersion>
		<SImulatorVersion>3.4.3</SImulatorVersion>
	</PropertyGroup>
	
	<PropertyGroup>
		<SIOutputPlatform Condition="'$(Platform)' == ''">AnyCPU</SIOutputPlatform>
		<SIOutputPlatform Condition="'$(Platform)' != ''">$(Platform)</SIOutputPlatform>
		<SIOutputConfiguration Condition="'$(Configuration)' == ''">Debug</SIOutputConfiguration>
		<SIOutputConfiguration Condition="'$(Configuration)' != ''">$(Configuration)</SIOutputConfiguration>
		<BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(SIOutputPlatform).$(SIOutputConfiguration)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
		<OutputPath>$(MSBuildThisFileDirectory)bin/$(SIOutputPlatform).$(SIOutputConfiguration)/$(MSBuildProjectName)/</OutputPath>
	</PropertyGroup>
</Project>
