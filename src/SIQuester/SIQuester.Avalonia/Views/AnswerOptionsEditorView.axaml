<UserControl
    x:Class="SIQuester.Avalonia.Views.AnswerOptionsEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SIQuester.ViewModel"
    xmlns:loc="using:SIQuester.Avalonia.Localization"
    xmlns:views="using:SIQuester.Avalonia.Views"
    x:Name="Root"
    x:DataType="views:AnswerOptionsEditorView">
  <StackPanel Margin="{StaticResource FieldMargin}">
    <TextBlock Classes="field-label" Text="{x:Static loc:UiStrings.AnswerOptions}" />
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" Margin="{StaticResource FieldMargin}">
      <TextBlock Text="{x:Static loc:UiStrings.RightOption}" />
      <TextBlock Text="{Binding Question.PrimaryRightAnswer, ElementName=Root}" FontWeight="SemiBold" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Options.GroupValue, ElementName=Root}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StepParameterRecord">
          <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource Space8Thickness}">
            <StackPanel>
              <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
              <views:ContentItemsEditorView Editor="{Binding Value.ContentValue}" />
              <WrapPanel>
                <Button
                    Classes="command"
                    Content="{x:Static loc:UiStrings.MarkRightAnswer}"
                    AutomationProperties.Name="{x:Static loc:UiStrings.MarkRightAnswer}"
                    Command="{Binding Options.GroupValue.MakeRight, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Margin="{StaticResource MetadataCommandMargin}" />
                <Button
                    Classes="command"
                    Content="{x:Static loc:UiStrings.Delete}"
                    AutomationProperties.Name="{x:Static loc:UiStrings.Delete}"
                    Command="{Binding Options.GroupValue.DeleteItem, ElementName=Root}"
                    CommandParameter="{Binding}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button
        Classes="command"
        Content="{x:Static loc:UiStrings.AddOption}"
        AutomationProperties.Name="{x:Static loc:UiStrings.AddOption}"
        Command="{Binding Options.GroupValue.AddItem, ElementName=Root}"
        CommandParameter="{Binding Question, ElementName=Root}"
        HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
