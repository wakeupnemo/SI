<Window
    x:Class="SIQuester.Avalonia.Views.MessageDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SIQuester.Avalonia.Localization"
    Width="520"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Title="{x:Static loc:UiStrings.AppTitle}">
  <Grid Margin="{StaticResource Space24Thickness}" RowDefinitions="Auto,Auto">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="{StaticResource TypographyBodyLarge}" MaxWidth="472" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space8}" Margin="{StaticResource DialogButtonMargin}">
      <Button x:Name="CancelButton" Classes="command" Content="{x:Static loc:UiStrings.Cancel}" Click="Cancel_Click" />
      <Button x:Name="DiscardButton" Classes="command" Content="{x:Static loc:UiStrings.Discard}" Click="Discard_Click" />
      <Button x:Name="NoButton" Classes="command" Content="{x:Static loc:UiStrings.No}" Click="No_Click" />
      <Button x:Name="SaveButton" Classes="command accent" Content="{x:Static loc:UiStrings.Save}" Click="Save_Click" />
      <Button x:Name="YesButton" Classes="command accent" Content="{x:Static loc:UiStrings.Yes}" Click="Yes_Click" />
      <Button x:Name="OkButton" Classes="command accent" Content="{x:Static loc:UiStrings.OK}" Click="Ok_Click" />
    </StackPanel>
  </Grid>
</Window>
