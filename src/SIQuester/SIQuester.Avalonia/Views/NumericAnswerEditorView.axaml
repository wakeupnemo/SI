<UserControl
    x:Class="SIQuester.Avalonia.Views.NumericAnswerEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SIQuester.ViewModel"
    xmlns:loc="using:SIQuester.Avalonia.Localization"
    x:DataType="vm:NumericAnswerViewModel">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space8}" Margin="{StaticResource FieldMargin}">
    <StackPanel>
      <TextBlock Classes="field-label" Text="{x:Static loc:UiStrings.NumericAnswer}" />
      <NumericUpDown
          Value="{Binding Answer, Mode=TwoWay}"
          Minimum="-2147483648"
          Maximum="2147483647"
          AutomationProperties.Name="{x:Static loc:UiStrings.NumericAnswer}" />
    </StackPanel>
    <StackPanel Grid.Column="1">
      <TextBlock Classes="field-label" Text="{x:Static loc:UiStrings.AnswerDeviation}" />
      <NumericUpDown
          Value="{Binding Deviation, Mode=TwoWay}"
          Minimum="-2147483648"
          Maximum="2147483647"
          AutomationProperties.Name="{x:Static loc:UiStrings.AnswerDeviation}" />
    </StackPanel>
  </Grid>
</UserControl>
