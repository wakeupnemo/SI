<UserControl
    x:Class="SIQuester.Avalonia.Views.FlatDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SIQuester.ViewModel"
    xmlns:loc="using:SIQuester.Avalonia.Localization"
    x:DataType="vm:QDocument">
  <Grid RowDefinitions="Auto,*">
    <TextBlock
        Text="{x:Static loc:UiStrings.FlatViewDragHint}"
        TextWrapping="Wrap"
        Margin="{StaticResource FieldMargin}" />
    <ScrollViewer
        Grid.Row="1"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Package.Rounds}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RoundViewModel">
            <StackPanel Margin="{StaticResource FieldMargin}">
              <TextBlock Classes="section-title" Text="{Binding Model.Name}" />
              <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeViewModel">
                    <Border Classes="card" Margin="{StaticResource FieldMargin}">
                      <StackPanel Spacing="{StaticResource Space8}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Model.Name}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                          <ItemsControl ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:QuestionViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                                  <Border
                                      Classes="flat-drop-target"
                                      Width="{StaticResource DropIndicatorWidth}"
                                      Background="{DynamicResource SystemAccentColor}"
                                      Opacity="0.25"
                                      DragDrop.AllowDrop="True"
                                      DragDrop.DragOver="DropTarget_DragOver"
                                      DragDrop.DragLeave="DropTarget_DragLeave"
                                      DragDrop.Drop="QuestionDropTarget_Drop" />
                                  <Border
                                      Classes="card"
                                      Width="{StaticResource FlatQuestionWidth}"
                                      PointerPressed="Question_PointerPressed"
                                      PointerCaptureLost="Question_PointerCaptureLost"
                                      ToolTip.Tip="{x:Static loc:UiStrings.FlatViewDragHint}">
                                    <StackPanel>
                                      <TextBlock Text="{x:Static loc:UiStrings.Price}" />
                                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Model.Price}" />
                                    </StackPanel>
                                  </Border>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border
                              Classes="flat-drop-target"
                              Width="{StaticResource DropIndicatorWidth}"
                              MinHeight="{StaticResource FlatDropTargetMinHeight}"
                              Background="{DynamicResource SystemAccentColor}"
                              Opacity="0.25"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="DropTarget_DragOver"
                              DragDrop.DragLeave="DropTarget_DragLeave"
                              DragDrop.Drop="ThemeEndDropTarget_Drop" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
