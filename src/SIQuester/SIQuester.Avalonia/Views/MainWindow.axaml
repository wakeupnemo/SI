<Window
    x:Class="SIQuester.Avalonia.Views.MainWindow"
    x:Name="MainRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SIQuester.ViewModel"
    xmlns:views="using:SIQuester.Avalonia.Views"
    xmlns:loc="using:SIQuester.Avalonia.Localization"
    x:DataType="vm:MainViewModel"
    Title="{x:Static loc:UiStrings.AppTitle}"
    Icon="/Assets/logo.png"
    Width="1200"
    Height="760"
    MinWidth="900"
    MinHeight="480">

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:QDocument}">
      <views:DocumentEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NewViewModel}">
      <views:NewPackageView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DocumentLoaderViewModel}">
      <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource Space12}">
          <ProgressBar IsIndeterminate="True" Width="260" />
          <TextBlock Text="{x:Static loc:UiStrings.Loading}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImportTextViewModel}">
      <views:ImportTextView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding New}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding Open}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding ActiveDocument.Save}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding ActiveDocument.SaveAs}" />
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding Close}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="{x:Static loc:UiStrings.File}">
        <MenuItem Header="{x:Static loc:UiStrings.New}" Command="{Binding New}" InputGesture="Ctrl+N" />
        <MenuItem Header="{x:Static loc:UiStrings.Open}" Command="{Binding Open}" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="{x:Static loc:UiStrings.Save}" Command="{Binding ActiveDocument.Save}" InputGesture="Ctrl+S" />
        <MenuItem Header="{x:Static loc:UiStrings.SaveAs}" Command="{Binding ActiveDocument.SaveAs}" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="{x:Static loc:UiStrings.Close}" Command="{Binding ActiveWorkspace.Close}" />
        <MenuItem Header="{x:Static loc:UiStrings.Exit}" Command="{Binding Close}" InputGesture="Ctrl+Q" />
      </MenuItem>
      <MenuItem Header="{x:Static loc:UiStrings.Edit}">
        <MenuItem Header="{x:Static loc:UiStrings.Undo}" Command="{Binding ActiveDocument.OperationsManager.Undo}" InputGesture="Ctrl+Z" />
        <MenuItem Header="{x:Static loc:UiStrings.Redo}" Command="{Binding ActiveDocument.OperationsManager.Redo}" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="{x:Static loc:UiStrings.Cut}" Command="{Binding ActiveDocument.Cut}" InputGesture="Ctrl+X" />
        <MenuItem Header="{x:Static loc:UiStrings.Copy}" Command="{Binding ActiveDocument.Copy}" InputGesture="Ctrl+C" />
        <MenuItem Header="{x:Static loc:UiStrings.Paste}" Command="{Binding ActiveDocument.Paste}" InputGesture="Ctrl+V" />
      </MenuItem>
      <MenuItem Header="{x:Static loc:UiStrings.View}">
        <MenuItem Header="{x:Static loc:UiStrings.Options}" Command="{Binding SetSettings}" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <ScrollViewer
          x:Name="MainCommandBarScrollViewer"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" Margin="{StaticResource CommandBarPadding}">
          <Button Classes="command" Content="{x:Static loc:UiStrings.New}" Command="{Binding New}" AutomationProperties.Name="{x:Static loc:UiStrings.New}" />
          <Button Classes="command" Content="{x:Static loc:UiStrings.Open}" Command="{Binding Open}" AutomationProperties.Name="{x:Static loc:UiStrings.Open}" />
          <Button Classes="command" Content="{x:Static loc:UiStrings.Save}" Command="{Binding ActiveDocument.Save}" AutomationProperties.Name="{x:Static loc:UiStrings.Save}" />
          <Button Classes="command" Content="{x:Static loc:UiStrings.SaveAs}" Command="{Binding ActiveDocument.SaveAs}" AutomationProperties.Name="{x:Static loc:UiStrings.SaveAs}" />
          <Separator />
          <Button Classes="command" Content="{x:Static loc:UiStrings.Undo}" Command="{Binding ActiveDocument.OperationsManager.Undo}" AutomationProperties.Name="{x:Static loc:UiStrings.Undo}" />
          <Button Classes="command" Content="{x:Static loc:UiStrings.Redo}" Command="{Binding ActiveDocument.OperationsManager.Redo}" AutomationProperties.Name="{x:Static loc:UiStrings.Redo}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <Border
          x:Name="RecoveryCenter"
          Grid.Row="0"
          Classes="card"
          Margin="16,16,16,0"
          IsVisible="{Binding HasRecoveryEntries}">
        <StackPanel Spacing="{StaticResource Space12}">
          <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock Text="{x:Static loc:UiStrings.RecoveryTitle}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:UiStrings.RecoveryDescription}" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RecoveryEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecoveryEntryViewModel">
                  <Border
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource RadiusSmall}"
                      Padding="{StaticResource Space12Thickness}"
                      Margin="0,0,0,8">
                    <StackPanel Spacing="{StaticResource Space8}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Static loc:UiStrings.RecoveryAvailable}" IsVisible="{Binding !IsStale}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Static loc:UiStrings.RecoveryStale}"
                            IsVisible="{Binding IsStale}"
                            ToolTip.Tip="{x:Static loc:UiStrings.RecoveryStaleDescription}" />
                      </Grid>

                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <TextBlock Text="{x:Static loc:UiStrings.RecoveryOriginalPath}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding OriginalPath}" IsVisible="{Binding HasOriginalPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OriginalPath}" />
                        <TextBlock Grid.Column="1" Text="{x:Static loc:UiStrings.RecoveryUnsavedDocument}" IsVisible="{Binding !HasOriginalPath}" />
                        <TextBlock Grid.Row="1" Text="{x:Static loc:UiStrings.RecoverySavedAt}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SavedAt, StringFormat='{}{0:g}'}" />
                        <TextBlock Grid.Row="2" Text="{x:Static loc:UiStrings.RecoverySizeBytes}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SnapshotLength, StringFormat='{}{0:N0}'}" />
                      </Grid>

                      <ProgressBar
                          IsIndeterminate="True"
                          IsVisible="{Binding IsBusy}"
                          MinHeight="4"
                          AutomationProperties.Name="{x:Static loc:UiStrings.Loading}" />

                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" IsVisible="{Binding !IsDiscardPending}">
                        <Button Classes="command" Content="{x:Static loc:UiStrings.Preview}" Command="{Binding Preview}" />
                        <Button Classes="command accent" Content="{x:Static loc:UiStrings.Restore}" Command="{Binding Restore}" IsEnabled="{Binding CanRestore}" IsVisible="{Binding !IsStale}" />
                        <Button Classes="command accent" Content="{x:Static loc:UiStrings.RestoreAsCopy}" Command="{Binding Restore}" IsEnabled="{Binding CanRestore}" IsVisible="{Binding IsStale}" />
                        <Button Classes="command" Content="{x:Static loc:UiStrings.RevealLocation}" Command="{Binding Reveal}" />
                        <Button Classes="command" Content="{x:Static loc:UiStrings.DiscardSnapshot}" Command="{Binding RequestDiscard}" />
                      </StackPanel>

                      <Border
                          Background="{DynamicResource LayerFillColorAltBrush}"
                          CornerRadius="{StaticResource RadiusSmall}"
                          Padding="{StaticResource Space8Thickness}"
                          IsVisible="{Binding IsDiscardPending}">
                        <StackPanel Spacing="{StaticResource Space8}">
                          <TextBlock Text="{x:Static loc:UiStrings.ConfirmDiscardSnapshot}" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                            <Button Classes="command" Content="{x:Static loc:UiStrings.DiscardSnapshot}" Command="{Binding ConfirmDiscard}" />
                            <Button Classes="command" Content="{x:Static loc:UiStrings.Cancel}" Command="{Binding CancelDiscard}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <Border
                          Background="{DynamicResource LayerFillColorAltBrush}"
                          CornerRadius="{StaticResource RadiusSmall}"
                          Padding="{StaticResource Space8Thickness}"
                          IsVisible="{Binding IsPreviewVisible}">
                        <StackPanel Spacing="{StaticResource Space4}">
                          <TextBlock Text="{x:Static loc:UiStrings.RecoveryPreview}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding PackageName}" TextTrimming="CharacterEllipsis" />
                          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Text="{x:Static loc:UiStrings.Rounds}" />
                            <TextBlock Grid.Column="1" Text="{Binding RoundCount}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Static loc:UiStrings.Themes}" />
                            <TextBlock Grid.Column="3" Text="{Binding ThemeCount}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="{x:Static loc:UiStrings.Questions}" />
                            <TextBlock Grid.Column="5" Text="{Binding QuestionCount}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="{x:Static loc:UiStrings.MediaFiles}" />
                            <TextBlock Grid.Column="7" Text="{Binding MediaCount}" FontWeight="SemiBold" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <TabControl
          Grid.Row="1"
          ItemsSource="{Binding DocList}"
          SelectedItem="{Binding ActiveWorkspace, Mode=TwoWay}"
          IsVisible="{Binding HasWorkspaces}">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkspaceViewModel">
            <Grid ColumnDefinitions="*,Auto" MinWidth="140" ToolTip.Tip="{Binding ToolTip}">
              <TextBlock Text="{Binding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button
                  Grid.Column="1"
                  Command="{Binding Close}"
                  Content="×"
                  Margin="{StaticResource TabCloseMargin}"
                  Padding="{StaticResource TabClosePadding}"
                  Background="Transparent"
                  AutomationProperties.Name="{x:Static loc:UiStrings.Close}" />
            </Grid>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>

      <Grid Grid.Row="1" IsVisible="{Binding !HasWorkspaces}">
        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <StackPanel Spacing="{StaticResource Space16}">
            <TextBlock Text="{x:Static loc:UiStrings.EmptyTitle}" FontSize="{StaticResource TypographyTitle}" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="{x:Static loc:UiStrings.EmptyDescription}" FontSize="{StaticResource TypographyBodyLarge}" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource Space8}">
              <Button Classes="command accent" Content="{x:Static loc:UiStrings.New}" Command="{Binding New}" />
              <Button Classes="command" Content="{x:Static loc:UiStrings.Open}" Command="{Binding Open}" />
            </StackPanel>
            <Separator />
            <TextBlock Text="{x:Static loc:UiStrings.RecentFiles}" FontSize="{StaticResource TypographyBodyLarge}" FontWeight="SemiBold" />
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Settings.History.Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="command"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenRecent}"
                        CommandParameter="{Binding}"
                        HorizontalContentAlignment="Left"
                        ToolTip.Tip="{Binding}">
                      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="{StaticResource StatusBarPadding}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{x:Static loc:UiStrings.StatusReady}" />
        <TextBlock Grid.Column="1" Text="{Binding ActiveDocument.ErrorMessage}" />
      </Grid>
    </Border>
  </Grid>
</Window>
