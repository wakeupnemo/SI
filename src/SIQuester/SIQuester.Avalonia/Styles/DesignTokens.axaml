<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space32">32</x:Double>
    <x:Double x:Key="TypographyBodyLarge">15</x:Double>
    <x:Double x:Key="TypographyTitle">28</x:Double>
    <x:Double x:Key="ControlHeight">36</x:Double>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <Thickness x:Key="Space4Thickness">4</Thickness>
    <Thickness x:Key="Space12Thickness">12</Thickness>
    <Thickness x:Key="Space16Thickness">16</Thickness>
    <Thickness x:Key="Space24Thickness">24</Thickness>
    <Thickness x:Key="Space32Thickness">32</Thickness>
    <Thickness x:Key="CommandBarPadding">12,8</Thickness>
    <Thickness x:Key="StatusBarPadding">12,6</Thickness>
    <Thickness x:Key="TabCloseMargin">8,0,0,0</Thickness>
    <Thickness x:Key="TabClosePadding">4,0</Thickness>
    <Thickness x:Key="DialogButtonMargin">0,24,0,0</Thickness>
    <Thickness x:Key="PagePadding">16</Thickness>
    <Thickness x:Key="FieldLabelMargin">0,0,0,4</Thickness>
    <Thickness x:Key="FieldMargin">0,0,0,12</Thickness>
  </Styles.Resources>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="{StaticResource FieldMargin}" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="{StaticResource FieldLabelMargin}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="{StaticResource Space16Thickness}" />
  </Style>
  <Style Selector="Button.command">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource StatusBarPadding}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
  </Style>
</Styles>
