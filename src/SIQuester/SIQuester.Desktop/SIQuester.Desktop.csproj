<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>SIQuester Cross-Platform</AssemblyTitle>
    <Product>SIQuester Cross-Platform</Product>
    <Version>$(SIQuesterCrossPlatformVersion)</Version>
    <ApplicationIcon>..\SIQuester\Resources\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.1.1" />
    <PackageReference Include="VKhil.SIStatisticsService.Client" Version="1.5.0" />
    <PackageReference Include="VKhil.SIStorage.Client" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIQuester.Avalonia\SIQuester.Avalonia.csproj" />
    <ProjectReference Include="..\SIQuester.ViewModel\SIQuester.ViewModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SIQuester.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\test\SIGame\SIGame.Tests\SIGameTestEn.siq" Link="templates\SIGameTestEn.siq" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\test\SIGame\SIGame.Tests\SIGameTestNew.siq" Link="templates\SIGameTestNew.siq" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SIQuester\wwwroot\**\*"
          Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
