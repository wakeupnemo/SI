#!/bin/sh

set -eu

# WebKitGTK can initialize native rendering before managed Main runs. Keep the
# compatibility value in the process environment from the very first exec, but
# never override an explicit user choice (including an explicitly empty value).
if [ "${WEBKIT_DISABLE_COMPOSITING_MODE+x}" != x ]; then
    export WEBKIT_DISABLE_COMPOSITING_MODE=1
fi

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
executable="$script_directory/SIQuester.Desktop"

if [ ! -x "$executable" ]; then
    executable=/usr/lib/siquester/SIQuester.Desktop
fi

exec "$executable" "$@"
